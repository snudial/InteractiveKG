# Project-specific ignores. General Python/Node/OS rules live in the repository-root
# .gitignore. Every pattern here is anchored with a leading `/` so that it cannot
# accidentally match a nested source directory — an unanchored `lib/` previously
# swallowed frontend/src/lib/ and kept the API client modules out of version control.

# Neo4j runtime state (created by docker-compose)
/data/
/logs/
/import/
/plugins/
/conf/

# Backend
/backend/lib/
/backend/lib64/
/backend/build/
/backend/dist/
/backend/*.egg-info/

# Frontend build output
/frontend/.next/
/frontend/out/
/frontend/tsconfig.tsbuildinfo
