# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration
# Options: openai_gpt4o_mini, ollama_local, disabled
LLM_PROVIDER=disabled

# OpenAI Configuration (if using openai_gpt4o_mini)
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL_NAME=gpt-4o-mini

# Ollama Configuration (if using ollama_local)
LLM_BASE_URL=http://localhost:11434
# LLM_MODEL_NAME=llama3.2:3b

# LLM General Settings
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# External KGOT project (clone https://github.com/spcl/knowledge-graph-of-thoughts)
# Defaults to a sibling directory of this repository when unset
#KGOT_PROJECT_ROOT=/path/to/knowledge-graph-of-thoughts
# KGOT Python executor container endpoint
#PYTHON_EXECUTOR_URI=http://localhost:16000/run
